{
  "name": "polyland",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Polyland - a pixel-art arcade hub for polygon characters",
  "scripts": {
    "dev": "vite",
    "server": "node server/index.mjs",
    "dev:all": "node scripts/dev-all.mjs",
