{
  "name": "localrot",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A browser 3D world, built through a gated module pipeline",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check:frozen": "node scripts/check-frozen.mjs",
    "check:contracts": "node scripts/check-contracts.mjs",
    "check:budgets": "node scripts/check-budgets.mjs",
    "check": "npm run check:boundaries && npm run check:frozen && npm run check:contracts && npm run check:budgets",
    "gate": "node scripts/gate.mjs",
    "gate:pass": "node scripts/gate-pass.mjs",
    "gate:fail": "node scripts/gate-fail.mjs",
    "unfreeze": "node scripts/unfreeze.mjs",
    "music:scan": "node scripts/scan-music.mjs",
    "relay": "node server/relay.mjs",
    "start": "node server/relay.mjs",
    "dev:multi": "npm run build && node server/relay.mjs",
    "brief": "node scripts/brief.mjs",
    "brief:turn-order": "node scripts/brief.mjs 52-turn-order",
    "test:turn-order": "vitest run src/modules/52-turn-order",
    "gate:turn-order": "node scripts/gate.mjs 52-turn-order",
    "brief:board-movement": "node scripts/brief.mjs 53-board-movement",
    "test:board-movement": "vitest run src/modules/53-board-movement",
    "gate:board-movement": "node scripts/gate.mjs 53-board-movement",
    "brief:minigame-round": "node scripts/brief.mjs 54-minigame-round",
    "test:minigame-round": "vitest run src/modules/54-minigame-round",
    "gate:minigame-round": "node scripts/gate.mjs 54-minigame-round",
    "brief:reward-dice": "node scripts/brief.mjs 55-reward-dice",
    "test:reward-dice": "vitest run src/modules/55-reward-dice",
    "gate:reward-dice": "node scripts/gate.mjs 55-reward-dice",
    "brief:volcano-victory": "node scripts/brief.mjs 56-volcano-victory",
    "test:volcano-victory": "vitest run src/modules/56-volcano-victory",
    "gate:volcano-victory": "node scripts/gate.mjs 56-volcano-victory",
    "brief:volcano-postgame": "node scripts/brief.mjs 57-volcano-postgame",
    "test:volcano-postgame": "vitest run src/modules/57-volcano-postgame",
    "gate:volcano-postgame": "node scripts/gate.mjs 57-volcano-postgame",
    "brief:breaking-the-ice": "node scripts/brief.mjs 58-breaking-the-ice",
    "test:breaking-the-ice": "vitest run src/modules/58-breaking-the-ice",
    "gate:breaking-the-ice": "node scripts/gate.mjs 58-breaking-the-ice",
    "brief:volcano-tile-actions": "node scripts/brief.mjs 59-volcano-tile-actions",
    "test:volcano-tile-actions": "vitest run src/modules/59-volcano-tile-actions",
    "gate:volcano-tile-actions": "node scripts/gate.mjs 59-volcano-tile-actions",
    "brief:volcano-map-landmarks": "node scripts/brief.mjs 60-volcano-map-landmarks",
    "test:volcano-map-landmarks": "vitest run src/modules/60-volcano-map-landmarks",
    "gate:volcano-map-landmarks": "node scripts/gate.mjs 60-volcano-map-landmarks"
  },
  "dependencies": {
    "@react-three/fiber": "^9.7.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.185.1",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/node": "^26.5.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^29.1.1",
    "typescript": "^5.6.3",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
